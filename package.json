{
  "name": "@pi-kode/context",
  "version": "0.1.0",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "description": "Standalone pi extension: PIKODE.md / .pi/rules (with CLAUDE.md / .claude/rules compatibility) memory and context loading",
  "files": [
    "index.ts",
    "lib"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "typebox": "1.3.27"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-kode/context.git"
  },
  "homepage": "https://github.com/pi-kode/context#readme",
  "bugs": "https://github.com/pi-kode/context/issues",
  "publishConfig": {
    "access": "public"
  }
}
